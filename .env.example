# ─── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Server (guild) ID the bot works in. Leave empty to use the first server the bot is in.
DISCORD_GUILD_ID=
# Optional: voice channel to join automatically when someone queues music from the web UI.
# If empty, the bot joins the voice channel with the most people in it.
DISCORD_VOICE_CHANNEL_ID=
# ─── Web login (Discord OAuth2) ─────────────────────────────────────────────
# Developer portal → your app → OAuth2 → Client Secret ("Reset Secret").
DISCORD_CLIENT_SECRET=
# Only needed if your app's client ID differs from the bot's user ID (very old apps).
DISCORD_CLIENT_ID=
# Only members of the bot's Discord server may use the web UI.
REQUIRE_GUILD_MEMBER=true
# How long a web login lasts.
SESSION_DAYS=30

# Control API for other programs, e.g. a voice assistant bot (POST /api/control/play, /skip, ...).
# Requests must send "Authorization: Bearer <CONTROL_TOKEN>". Leave empty to turn the API off.
# Generate one with: openssl rand -hex 32
CONTROL_TOKEN=

# Leave the voice channel after it has been empty this many minutes (0 = never).
AUTO_LEAVE_MINUTES=5

# ─── Library & storage ──────────────────────────────────────────────────────
# Folder with your music (scanned recursively). Relative paths are relative to this project.
MUSIC_DIR=./music
# Library cache, saved queue and downloaded URL tracks.
DATA_DIR=./data
# Watch MUSIC_DIR for changes. Set WATCH_POLLING=true for network shares / Docker on Windows.
WATCH_LIBRARY=true
WATCH_POLLING=false
# Largest file accepted from "Add from URL".
MAX_DOWNLOAD_MB=200

# ─── Web UI ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
HTTP_PORT=3000
# Public address of the web UI (e.g. http://192.168.1.20:3000). Used for /web and as the OAuth
# redirect base (<PUBLIC_URL>/auth/callback). When empty, the address in the browser is used.
PUBLIC_URL=

# ─── Audio ──────────────────────────────────────────────────────────────────
# Path to ffmpeg if it is not on PATH.
FFMPEG_PATH=ffmpeg
DEFAULT_VOLUME=60
