    "@fastify/static": "^10.1.5",
    "chokidar": "^5.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.6",
    "fastify": "^5.12.5",
    "fuse.js": "^7.5.0",
    "music-metadata": "^12.0.0",
    "opusscript": "^0.0.8",
    "socket.io": "^4.8.4"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
